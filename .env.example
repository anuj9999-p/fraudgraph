# ===== FraudGraph AI configuration (copy to .env and edit) =====
# Backend reads these from the process environment. Unset/empty values use the defaults shown.
# Local run: `set -a; source .env; set +a` before starting uvicorn. Docker: compose loads .env automatically.

# --- Security ---
FG_API_KEY=change-me                      # REQUIRED for upload, alert updates, config changes (503 if unset). Use a long random value.
FG_ANALYST_API_KEY=                       # optional second key with analyst role (may update alert case status only; must differ from FG_API_KEY)
FG_RATE_LIMIT_PER_MINUTE=300              # per client, all requests except /health and /ready (0 disables)
FG_RATE_LIMIT_WRITE_PER_MINUTE=30         # per client, POST/PATCH/PUT/DELETE (0 disables)
FG_AUTH_FAIL_LIMIT=10                     # failed key attempts per minute per client before 429 lockout (0 disables)
FG_TRUST_PROXY=false                      # true only behind a trusted reverse proxy that sets X-Forwarded-For
FG_CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # comma-separated allowed browser origins

# --- Storage ---
FG_DATABASE_URL=                          # default: sqlite:///<FG_DATA_DIR>/fraudgraph.db ; Postgres e.g. postgresql+psycopg://user:pass@host:5432/db (driver not bundled; add psycopg to requirements)
FG_DATA_DIR=                              # default: <repo>/data  (docker-compose sets /data)
FG_ARTIFACT_DIR=                          # default: <repo>/artifacts (docker-compose sets /artifacts)
FG_DB_AUTO_CREATE=true                    # true: create tables on first use (dev). false: require `alembic upgrade head` (production; /ready fails until applied)
FG_MAX_UPLOAD_MB=300                      # per-file upload limit

# --- Runtime ---
FG_LOG_LEVEL=INFO
FG_SEED=42                                # default seed for synthetic data / experiments

# --- Chronological evaluation split (train + val < 1; test is the remainder) ---
FG_TRAIN_FRAC=0.6
FG_VAL_FRAC=0.2
FG_TUNE_TAUS_DAYS=0.25,1,4,16             # decay time constants tried; chosen on validation PR-AUC (uploads and experiments)
FG_TUNE_RULE=conservative                 # conservative: keep the default tau unless another beats it in >= FG_TUNE_CONFIDENCE of bootstrap resamples; argmax: best validation PR-AUC
FG_TUNE_CONFIDENCE=0.95
FG_TUNE_BOOTSTRAP=200                     # cluster-bootstrap resamples of validation accounts

# --- Decision policy defaults (editable at runtime via PATCH /api/v1/config; 0 <= medium <= high <= critical <= 1) ---
FG_RISK_MEDIUM=0.3
FG_RISK_HIGH=0.6
FG_RISK_CRITICAL=0.9
FG_CLUSTER_RISK=0.6                       # entity risk needed to join a suspicious cluster
FG_CLUSTER_MIN_SIZE=3
FG_CLUSTER_CHECKPOINTS=30                 # time slices at which clusters are detected (more = finer detection-time resolution, slower load)

# --- ATFRP overrides (leave unset to keep algorithm defaults) ---
# FG_ATFRP_TAU_DAYS=1                     # neighborhood decay time constant (days)
# FG_ATFRP_TAU_T_HOURS=1                  # recency (T) time constant (hours)
# FG_ATFRP_MIN_HISTORY=3                  # events before behavioral deviation is defined
# FG_ATFRP_Z_SCALE=3.0
# FG_ATFRP_HIGH_THRESHOLD=0.5             # neighbor counted "high risk" for concentration C
# FG_ATFRP_CONC_REF=2
# FG_ATFRP_ENTITY_EWMA=0.5
# FG_ATFRP_MAX_FANOUT=50                  # ignore identifiers already shared by more accounts

# --- Frontend (dev server only; build-time) ---
# VITE_API_PROXY=http://localhost:8000    # where `npm run dev` proxies /api
